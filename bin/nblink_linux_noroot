#!/usr/bin/env bash
# codex魔改版，基于 owjdxb v4.3.4 https://iepose.com/install.sh 绕过 sudo 权限改用 tmux 挂后台
set -Eeuo pipefail

APP_NAME="owjdxb"
VERSION="4.3.4"
BUILD_ID="718"
BASE_URL="https://cdn.ionewu.com/upgrade/jdxb"
PORT="9118"

APP_DIR="${HOME}/.local/share/${APP_NAME}"
CACHE_DIR="${HOME}/.cache/${APP_NAME}"
UNIT_FILE="${HOME}/.config/systemd/user/${APP_NAME}.service"
UNIT_WANTS="${HOME}/.config/systemd/user/default.target.wants/${APP_NAME}.service"
TMUX_SESSION="${APP_NAME}"
LOG_DIR="/tmp/.${APP_NAME}"
DETACHED_LOG="${CACHE_DIR}/last-disruptive-action.log"

log() {
  printf '%s\n' "$*"
}

warn() {
  printf 'WARNING: %s\n' "$*" >&2
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: owjdxb-user.sh COMMAND

Commands:
  install     Download and install; start only if not already running
  update      Replace files without stopping the running client
  install --restart / update --restart
              Replace files, then restart in a detached background job
  start       Start in a tmux session
  stop        DANGEROUS: stop the app and remove the tmux session
  restart     DANGEROUS: restart in a detached background job
  status      Show service status
  bind        Print the device binding URL and optional terminal QR code
  uninstall   DANGEROUS: stop and remove the application files
  attach      Attach to the tmux log session
  help        Show this help

This script never uses sudo for normal operation. It installs under
~/.local/share and uses tmux instead of systemd.

WARNING: stop/restart/uninstall and install/update with --restart can break the
current SSH connection if this host is reached through this P2P tunnel. Those
forms ask for confirmation, run the actual work detached, and then disconnect
this shell. Plain install/update only swaps files while the client keeps
running, so the tunnel and this session stay up; the new build takes effect on
the next restart.

start/status (and the update path) also report how long ago the client last saw
a peer device. If nothing has been seen for 3 minutes, either the Mac-side
client is closed or the device needs re-activation after a network change; in
the latter case run "bind" and click 登录激活 (or 解绑 if that account is not
yours).
EOF
}

require_user() {
  [[ "${EUID}" -ne 0 ]] || die "Run this script as your normal user, not with sudo."
  [[ "$(uname -s)" == "Linux" ]] || die "Only Linux is supported."
}

require_commands() {
  local command_name
  for command_name in curl tar find chmod grep sed head tr mktemp mv rm dirname pgrep ss nohup sleep kill; do
    command -v "${command_name}" >/dev/null 2>&1 || die "Missing command: ${command_name}"
  done
  command -v tmux >/dev/null 2>&1 || die "Missing command: tmux"
}

package_filename() {
  case "$(uname -m)" in
  x86_64 | amd64)
    printf '%s_linux_x64_%s-%s.tgz\n' "${APP_NAME}" "${VERSION}" "${BUILD_ID}"
    ;;
  aarch64 | arm64)
    printf '%s_linux_arm64_%s-%s.tgz\n' "${APP_NAME}" "${VERSION}" "${BUILD_ID}"
    ;;
  armv7l | armv6l | armv5tel)
    printf '%s_linux_arm32_%s-%s.tgz\n' "${APP_NAME}" "${VERSION}" "${BUILD_ID}"
    ;;
  *)
    die "Unsupported architecture: $(uname -m)"
    ;;
  esac
}

download_package() {
  local filename archive url
  filename="$(package_filename)"
  archive="${CACHE_DIR}/${filename}"
  url="${BASE_URL}/${filename}"

  mkdir -p "${CACHE_DIR}"
  if [[ -f "${archive}" ]]; then
    log "Using cached package: ${archive}" >&2
  else
    log "Downloading ${url}" >&2
    curl -fL --retry 3 --progress-bar -o "${archive}" "${url}"
  fi

  printf '%s\n' "${archive}"
}

stop_service_if_present() {
  if [[ -x "${APP_DIR}/stop.sh" ]]; then
    "${APP_DIR}/stop.sh" >/dev/null 2>&1 || true
  fi
  tmux has-session -t "${TMUX_SESSION}" 2>/dev/null && tmux kill-session -t "${TMUX_SESSION}" || true
}

install_files() {
  local archive stop_before_swap data_dir temp_dir extracted_dir backup_dir
  archive="$1"
  stop_before_swap="${2:-0}"
  data_dir="$(dirname "${APP_DIR}")"
  mkdir -p "${data_dir}"

  if tar -tzf "${archive}" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then
    die "Archive contains an unsafe path: ${archive}"
  fi

  temp_dir="$(mktemp -d "${data_dir}/.${APP_NAME}.new.XXXXXX")"
  backup_dir="${data_dir}/.${APP_NAME}.backup.$$"
  trap 'rm -rf "${temp_dir:-}" "${backup_dir:-}"' RETURN

  tar -xzf "${archive}" -C "${temp_dir}"
  extracted_dir="${temp_dir}/${APP_NAME}"
  [[ -f "${extracted_dir}/start.sh" ]] || die "Package does not contain ${APP_NAME}/start.sh"

  chmod +x "${extracted_dir}/start.sh"
  find "${extracted_dir}" -type f \
    \( -name '*.sh' -o -path '*/bin/*' -o -path '*/ownbsv/*' \) \
    -exec chmod +x {} \; 2>/dev/null || true

  if [[ "${stop_before_swap}" == "1" ]]; then
    stop_service_if_present
  fi

  if [[ -e "${APP_DIR}" ]]; then
    mv "${APP_DIR}" "${backup_dir}"
  fi

  if mv "${extracted_dir}" "${APP_DIR}"; then
    rm -rf "${backup_dir}" "${temp_dir}"
  else
    [[ ! -e "${APP_DIR}" && -e "${backup_dir}" ]] && mv "${backup_dir}" "${APP_DIR}"
    die "Could not install files into ${APP_DIR}"
  fi

  trap - RETURN
}

remove_old_user_unit() {
  if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
    systemctl --user stop "${APP_NAME}.service" >/dev/null 2>&1 || true
    systemctl --user disable "${APP_NAME}.service" >/dev/null 2>&1 || true
  fi
  rm -f "${UNIT_WANTS}" "${UNIT_FILE}"
  if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
    systemctl --user daemon-reload >/dev/null 2>&1 || true
  fi
}

install_app() {
  local archive
  archive="$(download_package)"
  remove_old_user_unit
  install_files "${archive}"

  log "Installed files in ${APP_DIR}"
  start_app
}

# Replace files without touching the running process, so a tunnel-carried
# SSH session survives. The new build takes effect on the next start.
install_in_place() {
  local archive script_name
  script_name="$(basename "$0")"
  archive="$(download_package)"
  install_files "${archive}"

  log "Installed files in ${APP_DIR}"
  if pgrep -f "${APP_DIR}/bin/${APP_NAME}" >/dev/null 2>&1; then
    log "${APP_NAME} is still running the previous build; the tunnel was left up."
    log "Run '${script_name} restart' when a short disconnect is acceptable, to switch builds."
    warn_if_peer_stale
  else
    remove_old_user_unit
    start_app
  fi
}

start_log_session() {
  mkdir -p "${LOG_DIR}"
  tmux has-session -t "${TMUX_SESSION}" 2>/dev/null && return 0
  tmux new-session -d -s "${TMUX_SESSION}" -c "${APP_DIR}" \
    "printf '[%s] ${APP_NAME} is running. Tailing logs from ${LOG_DIR}.\\n' \"\$(date)\"; touch ${LOG_DIR}/onewu.log; tail -n 80 -F ${LOG_DIR}/*.log"
}

start_app() {
  [[ -x "${APP_DIR}/start.sh" ]] || die "Not installed: ${APP_DIR}/start.sh"
  if pgrep -f "${APP_DIR}/bin/${APP_NAME}" >/dev/null 2>&1; then
    log "${APP_NAME} is already running."
    start_log_session
    status_app
    return 0
  fi

  tmux has-session -t "${TMUX_SESSION}" 2>/dev/null && tmux kill-session -t "${TMUX_SESSION}" || true
  tmux new-session -d -s "${TMUX_SESSION}" -c "${APP_DIR}" \
    "./start.sh; printf '\\n[%s] started. Tailing logs from ${LOG_DIR}.\\n' \"\$(date)\"; touch ${LOG_DIR}/onewu.log; tail -n 80 -F ${LOG_DIR}/*.log"

  sleep 1
  if pgrep -f "${APP_DIR}/bin/${APP_NAME}" >/dev/null 2>&1; then
    log "Started ${APP_NAME} in tmux session: ${TMUX_SESSION}"
    log "Attach logs with: tmux attach -t ${TMUX_SESSION}"
    sleep 2
    wait_for_peer || warn_if_peer_stale
  else
    warn "${APP_NAME} did not stay running. Attach logs with: tmux attach -t ${TMUX_SESSION}"
    return 1
  fi
}

stop_app() {
  if [[ -x "${APP_DIR}/stop.sh" ]]; then
    "${APP_DIR}/stop.sh"
  else
    warn "No installed stop script was found."
  fi
  tmux has-session -t "${TMUX_SESSION}" 2>/dev/null && tmux kill-session -t "${TMUX_SESSION}" || true
}

restart_app() {
  stop_app || true
  start_app
}

confirm_disruptive_action() {
  local action answer token
  action="$1"
  token="YES ${action}"

  cat >/dev/tty <<EOF
WARNING: '${action}' may break your current SSH connection.

If this SSH session depends on ${APP_NAME}'s P2P tunnel, the connection will
drop while ${APP_NAME} is stopped. The script will run the real work in a
detached background job first, then disconnect this shell so you can reconnect.

Type exactly '${token}' to continue: 
EOF
  IFS= read -r answer </dev/tty || die "Could not read confirmation from /dev/tty"
  [[ "${answer}" == "${token}" ]] || die "Canceled."
}

disconnect_current_shell() {
  if [[ "${NBLINK_NO_DISCONNECT:-}" == "1" ]]; then
    warn "NBLINK_NO_DISCONNECT=1 is set; not disconnecting this shell."
    return 0
  fi

  if [[ -n "${SSH_CONNECTION:-}${SSH_TTY:-}" ]]; then
    warn "Disconnecting current SSH shell. Reconnect after a few seconds."
    sleep 1
    kill -HUP "${PPID}" 2>/dev/null || true
  else
    warn "No SSH environment was detected; leaving this shell attached."
  fi
}

run_detached_action() {
  local action script_path
  action="$1"
  script_path="$0"
  if [[ "${script_path}" != */* ]]; then
    script_path="$(command -v -- "${script_path}" 2>/dev/null || printf '%s\n' "${script_path}")"
  fi
  if command -v readlink >/dev/null 2>&1; then
    script_path="$(readlink -f "${script_path}" 2>/dev/null || printf '%s\n' "${script_path}")"
  fi

  mkdir -p "${CACHE_DIR}"
  : >"${DETACHED_LOG}"

  if command -v setsid >/dev/null 2>&1; then
    setsid nohup bash "${script_path}" "__${action}_detached" >>"${DETACHED_LOG}" 2>&1 </dev/null &
  else
    nohup bash "${script_path}" "__${action}_detached" >>"${DETACHED_LOG}" 2>&1 </dev/null &
  fi

  log "Scheduled detached '${action}'. Log: ${DETACHED_LOG}"
  log "Reconnect after a few seconds, then check: ${script_path} status"
  disconnect_current_shell
}

run_detached_payload() {
  local action archive
  action="$1"
  log "[$(date)] detached ${action} started"
  sleep 2

  case "${action}" in
  stop)
    stop_app
    ;;
  restart)
    stop_app || true
    sleep 3
    start_app
    ;;
  install | update)
    archive="$(download_package)"
    remove_old_user_unit
    install_files "${archive}" 1
    log "Installed files in ${APP_DIR}"
    sleep 3
    start_app
    ;;
  uninstall)
    stop_service_if_present
    remove_old_user_unit
    rm -rf "${APP_DIR}"
    log "Removed ${APP_DIR}"
    ;;
  *)
    die "Unknown detached action: ${action}"
    ;;
  esac

  log "[$(date)] detached ${action} finished"
}

status_app() {
  if pgrep -f "${APP_DIR}/bin/${APP_NAME}" >/dev/null 2>&1; then
    log "${APP_NAME}: running"
  else
    log "${APP_NAME}: stopped"
  fi

  if tmux has-session -t "${TMUX_SESSION}" 2>/dev/null; then
    log "tmux: ${TMUX_SESSION}"
  else
    log "tmux: no session"
  fi

  ss -tuln 2>/dev/null | grep -E "[:.]${PORT}[[:space:]]" || true
  pgrep -af "${APP_DIR}/bin/${APP_NAME}" || true
  pgrep -af "NodeBabyLinkService .*${APP_DIR}" || true
  report_peer_state
  warn_if_peer_stale
}

# The client log is silent until a device attaches, then carries a steady
# stream of health checks while it stays attached. So its age tells you whether
# a peer is currently connected; it cannot tell an idle Mac apart from a
# deactivated device, which is why the hint below is worded as a diagnosis aid.
peer_last_activity_age() {
  local log_file line stamp stamp_epoch
  log_file="${LOG_DIR}/NodeBabyLinkClient.log"
  [[ -f "${log_file}" ]] || return 1
  line="$(tail -n 1 "${log_file}" 2>/dev/null | cut -f1)"
  [[ -n "${line}" ]] || return 1
  stamp="${line:0:19}"
  [[ "${stamp}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}:[0-9]{2}$ ]] || return 1
  stamp_epoch="$(date -d "${stamp}" +%s 2>/dev/null)" || return 1
  printf '%s\n' "$(( $(date +%s) - stamp_epoch ))"
}

peer_is_fresh() {
  local age limit
  limit="${1:-180}"
  age="$(peer_last_activity_age)" || return 1
  if (( age <= limit )); then
    return 0
  fi
  return 1
}

wait_for_peer() {
  local attempt
  for attempt in 1 2 3 4 5; do
    if peer_is_fresh; then
      return 0
    fi
    sleep 2
  done
  return 1
}

report_peer_state() {
  local age
  if age="$(peer_last_activity_age)"; then
    if (( age < 0 )); then
      age=0
    fi
    log "peer: last activity ${age}s ago"
  else
    log "peer: no client activity logged yet"
  fi
}

warn_if_peer_stale() {
  if peer_is_fresh 180; then
    return 0
  fi

  log ""
  warn "最近 3 分钟没有检测到对端设备的活动。"
  warn "· Mac 端客户端没开：先打开它，这里应很快重新出现活动。"
  warn "· 已打开但仍连不上：通常是节点网络环境变化后设备待激活，"
  warn "  运行 '$(basename "$0") bind' 打开绑定链接，点击“登录激活”。"
  warn "  如果页面显示的账号不是你的，先点“解绑”。"
}

show_bind_url() {
  local attempt headers location
  for ((attempt = 1; attempt <= 30; attempt++)); do
    headers="$(curl -sS -D - -o /dev/null "http://127.0.0.1:${PORT}" 2>/dev/null || true)"
    location="$(printf '%s\n' "${headers}" | sed -n 's/^[Ll][Oo][Cc][Aa][Tt][Ii][Oo][Nn]:[[:space:]]*//p' | head -n 1 | tr -d '\r')"
    if [[ -n "${location}" ]]; then
      cat <<EOF
Device binding URL:
${location}

Open this URL in a browser on your Mac/Windows machine, then use WeChat to scan
or confirm the login page shown there. You do not need to open a browser on this
Linux server.
EOF
      if command -v qrencode >/dev/null 2>&1; then
        printf '\nTerminal QR code:\n'
        qrencode -t ANSIUTF8 "${location}"
      fi
      return 0
    fi
    [[ "${attempt}" -eq 30 ]] || sleep 5
  done
  die "No binding URL was returned by http://127.0.0.1:${PORT}"
}

uninstall_app() {
  stop_service_if_present
  remove_old_user_unit
  rm -rf "${APP_DIR}"
  log "Removed ${APP_DIR}"
  log "Cached downloads remain in ${CACHE_DIR}"
}

attach_app() {
  tmux has-session -t "${TMUX_SESSION}" 2>/dev/null || die "No tmux session: ${TMUX_SESSION}"
  exec tmux attach -t "${TMUX_SESSION}"
}

main() {
  require_user
  require_commands

  case "${1:-help}" in
  install | update)
    if [[ "${2:-}" == "--restart" ]]; then
      confirm_disruptive_action "${1}"
      run_detached_action "${1}"
    else
      install_in_place
    fi
    ;;
  start)
    start_app
    ;;
  stop)
    confirm_disruptive_action stop
    run_detached_action stop
    ;;
  restart)
    confirm_disruptive_action restart
    run_detached_action restart
    ;;
  status)
    status_app
    ;;
  bind)
    show_bind_url
    ;;
  uninstall)
    confirm_disruptive_action uninstall
    run_detached_action uninstall
    ;;
  attach)
    attach_app
    ;;
  __stop_detached)
    run_detached_payload stop
    ;;
  __restart_detached)
    run_detached_payload restart
    ;;
  __install_detached)
    run_detached_payload install
    ;;
  __update_detached)
    run_detached_payload update
    ;;
  __uninstall_detached)
    run_detached_payload uninstall
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
  esac
}

main "$@"
