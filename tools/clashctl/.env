######################################
#
#   用户自定义参数 更改后需 source 本文件后生效 
#
######################################

# 订阅下载超时时间（秒）
CLASHCTL_SUB_TIMEOUT=${CLASHCTL_SUB_TIMEOUT:-5}

# 订阅下载 UA
# Some providers use the client UA to choose a protocol. A modern Mihomo
# client UA avoids receiving legacy Shadowsocks nodes when AnyTLS is available.
CLASHCTL_SUB_UA=${CLASHCTL_SUB_UA:-clash-verge/v2.3.1}

# MSE keeps the kernel and subconverter in the repo bin. Deploy persists the
# private yq helper path separately so it does not live in the repository.
CLASHCTL_BIN_DIR=${CLASHCTL_BIN_DIR:-${CLASHCTL_HOME}/../../bin}
CLASHCTL_STATE_DIR=${CLASHCTL_STATE_DIR:-${CLASHCTL_HOME}/state}

######################################
#
#   以下参数由脚本自动生成，用户无需修改
#
######################################

# 实际安装的内核
CLASHCTL_KERNEL=${CLASHCTL_KERNEL:-}

# init 系统类型
INIT_TYPE=${INIT_TYPE:-}
